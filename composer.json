{
    "name": "roundly-consulting/metrics-for-laravel",
    "description": "Calculate value, trend, progress, and partition metrics from any Eloquent query.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "metrics",
        "analytics",
        "dashboard",
        "eloquent"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/metrics-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/metrics-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "roundly-consulting/enums-for-laravel": "^2.0",
        "roundly-consulting/package-toolkit-for-laravel": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "roundly-consulting/testing-for-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Metrics\\": "src",
            "RoundlyConsulting\\Metrics\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Metrics\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Metrics\\MetricsServiceProvider"
            ],
            "aliases": {
                "Metrics": "RoundlyConsulting\\Metrics\\Facades\\Metrics"
            }
        }
    }
}
